{
  "name": "contour-vectorizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "overrides": { "miniflare": { "sharp": "0.35.4" } },
  "scripts": {
    "prepare:wasm": "node scripts/prepare-wasm.mjs",
    "dev": "npm run prepare:wasm && vite --host 127.0.0.1",
    "build": "npm run prepare:wasm && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run prepare:wasm && playwright test",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "wrangler": "^4.130.0"
  }
}
